version 43
__lua__
--tools
function spawn_enemies_from_map()
	for ty=0,15 do
		for tx=0,15 do
			local id=mget(tx,ty)
			local typ=get_enemy_type(id)
			if typ then
				add(enemies, {
					typ=typ,
					x=tx*8,
					y=ty*8,
					hp=typ.maxhp
				})
				mset(tx,ty,0)
			end
		end
	end
end
-->8
--main
enemies={}

function _init()
	spawn_enemies_from_map()
end

function _update60()
	for e in all(enemies) do
		e.x+=e.typ.spd
	end
end

function _draw()
	cls()
	map()
	for e in all(enemies) do
		spr(e.typ.spr,e.x,e.y)
	end
end
-->8
--enemy
enemy_types={
	[17]={spr=1,maxhp=3,spd=0.2},
	[18]={spr=2,maxhp=2,spd=0.4},
	[19]={spr=3,maxhp=5,spd=0.3}
}

function get_enemy_type(id)
	return enemy_types[id]
end
