pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
--main
function _init()
	player=make_actor(2,3)
	history={}
end

function _update()
	for cmd in all(read_player_cmds(player)) do
		do_cmd(cmd)
	end
end

function _draw()
	cls()
	map(0,0,0,0,16,16)
	spr(3,player.x*8,player.y*8)
	print("hist "..#history,4,4,7)
end
-->8
--actor
function make_actor(x,y)
	return {
		x=x,
		y=y
	}
end

function actor_move(a,d)
	if (d==0) then a.x-=1 end
	if (d==1) then a.x+=1 end
	if (d==2) then a.y-=1 end
	if (d==3) then a.y+=1 end
end
-->8
--command
function move_cmd(a,d)
	local oldx, oldy
	return {
		execute=function()
			oldx,oldy=a.x,a.y
			actor_move(a,d)
		end,
		undo=function()
			a.x,a.y=oldx,oldy
		end
	}
end

function cmd_left(a)
	return move_cmd(a,0)
end

function cmd_right(a)
	return move_cmd(a,1)
end

function cmd_up(a)
	return move_cmd(a,2)
end

function cmd_down(a)
	return move_cmd(a,3)
end

function cmd_undo(a)
	return {
		execute=undo
	}
end

function cmd_action(a)
	return nil --todo
end
-->8
--history
function do_cmd(cmd)
	cmd.execute()
	if cmd.undo then
			add(history,cmd)
	end
end

function undo()
	if #history==0 then return end
	local cmd=history[#history]
	deli(history,#history)
	cmd.undo()
end
-->8
--director
binds={
	[0]=cmd_left,
	[1]=cmd_right,
	[2]=cmd_up,
	[3]=cmd_down,
	[4]=cmd_action,
	[5]=cmd_undo
}

function read_player_cmds(a)
	local cmds={}
	for b=0,5 do
		if btnp(b) then
			add(cmds,binds[b](a))
		end
	end
	return cmds
end
