version 43
__lua__
--main
enemies={}

function spawn_enemy(proto,x,y)
		local e=clone(proto)
		e.x=x
		e.y=y
		e.hp=e.maxhp
		e.alive=true
		add(enemies,e)
		return e
end

function _init()
	spawn_enemy(proto_slime,16,64)
	spawn_enemy(proto_fire_slime,32,64)
	spawn_enemy(proto_rock_slime,48,64)
end

function _update()
end

function _draw()
	cls()
	for e in all(enemies) do
		spr(e.spr,e.x,e.y)
	end
end
-->8
--enemy
proto_slime={
	spr=1,
	maxhp=3,
	hp=3,
	spd=0.3,
	dmg=1,
	dmg_type="normal",
	burns=false,
	armored=false,
	x=0,
	y=0,
	alive=true
}

--copy
function clone(proto)
	local e={}
	for k,v in pairs(proto) do
		e[k]=v
	end
	return e
end

proto_fire_slime=clone(proto_slime)
proto_fire_slime.spr=2
proto_fire_slime.maxhp=4
proto_fire_slime.spd=0.5
proto_fire_slime.dmg=2
proto_fire_slime.dmg_type="fire"
proto_fire_slime.burns=true

proto_rock_slime=clone(proto_slime)
proto_rock_slime.spr=3
proto_rock_slime.maxhp=8
proto_rock_slime.spd=0.25
proto_rock_slime.dmg=2
proto_rock_slime.armored=true
