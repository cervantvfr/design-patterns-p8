pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
--main

--spawn
particles={}

function spawn_particle(proto,x,y,dx,dy)
	local p=clone(proto)
	p.x=x
	p.y=y
	p.dx=dx or p.dx
	p.dy=dy or p.dy
	p.life=p.maxlife
	p.frame=1
	p.alive=true
	add(particles,p)
	return p
end

function burst_sparks(x,y)
	for i=1,6 do
	spawn_particle(
		proto_spark,
		x,y,
		(rnd(2)-1)*1.5,
		-rnd(1.5)
	)
	end
end

function puff_smoke(x,y)
	spawn_particle(proto_smoke,x,y,rnd(0.4)-0.2,-0.3)
end

function _init()
	burst_sparks(64,64)
	puff_smoke(40,80)
	spawn_particle(proto_ember,40,70,0.5,-0.6)
end

--animate
function anim_frame(p)
	local n=#p.frames
	local t=1-(p.life/p.maxlife)
	local i=flr(t*n)+1
	if i>n then i=n end
	p.frame=i
end

function _update60()
	for p in all(particles) do
		p.dy+=p.grav
		p.x+=p.dx
		p.y+=p.dy
		p.life-=1
		if p.life<=0 then
			p.alive=false
		else
			anim_frame(p)
		end
	end
	for p in all(particles) do
		if not p.alive then
			del(particles,p)
		end
	end
end

--draw
function _draw()
	cls()
	for p in all(particles) do
		spr(p.frames[p.frame],p.x,p.y)
	end
end
-->8
--particles
proto_particle={
	frames={48,49,50,51},
	frame=1,
	life=20,
	maxlife=20,
	x=0,
	y=0,
	dx=0,
	dy=-0.5,
	grav=0.05,
	alive=true
}

function clone(proto)
	local p={}
	for k,v in pairs(proto) do
		p[k]=v
	end
	return p
end

proto_spark=clone(proto_particle)
proto_spark.frames={48,49,50,51}
proto_spark.life=12
proto_spark.maxlife=12
proto_spark.grav=0.08

proto_smoke=clone(proto_particle)
proto_smoke.frames={52,53,54,55}
proto_smoke.life=100
proto_smoke.maxlife=25
proto_smoke.dy=-0.2
proto_smoke.grav=-0.01

proto_ember=clone(proto_particle)
proto_ember.frames={56,57,58,59}
proto_ember.life=28
proto_ember.maxlife=28
proto_ember.dx=0.3
proto_ember.dy=-0.4
proto_ember.grav=0.03
